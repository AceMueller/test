# Port the server listens on
PORT=3000

# Optional. If set, bots generate messages via the Claude API.
# If unset, bots fall back to a scripted canned-phrase generator.
ANTHROPIC_API_KEY=

# 'hash' (default) is a dependency-free, offline embedder and works
# everywhere. 'transformers' downloads a local model from huggingface.co
# on first use -- only set this if your network allows that host.
EMBEDDING_PROVIDER=hash
